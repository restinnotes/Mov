<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Mov" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFFFFFFF</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.Mov.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mov_icon_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_mov_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Mov</item>
    </style>
</resources>
