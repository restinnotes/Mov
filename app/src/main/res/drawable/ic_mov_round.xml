<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mov_icon_background" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp">
        <bitmap android:src="@drawable/mov_mark_mask" android:gravity="fill"
            android:filter="true" android:tint="@color/mov_icon_foreground" />
    </item>
</layer-list>
